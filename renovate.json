{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "automerge": true,
  "automergeType": "pr",
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "reviewers": [
        "engineers/infrastructure-engineers"
      ]
    }
  ],
  "dependencyDashboard": true,
  "configMigration": true,
  "reviewersFromCodeOwners": true,
  "expandCodeOwnersGroups": true
}
